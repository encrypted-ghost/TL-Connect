# TL Connect (Transfer Legacy) Environment Configuration

# App
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"

# --- AUTH ---
ADMIN_EMAIL="admin@transferlegacy.com"
ADMIN_PASSWORD="change-me-immediately"

# --- DATABASE & INFRASTRUCTURE (Supabase) ---
# Using Supabase REST API (HTTPS) to avoid IPv4 connection string issues.
SUPABASE_URL="https://fwfxgweiggqmtdmwlhnz.supabase.co"

# Your Supabase SECRET KEY (Service Role Secret)
# Found in Settings -> API. Used for server-side operations.
SUPABASE_SECRET_KEY="your-supabase-secret-key-here"

# Your Supabase PUBLISHABLE KEY (Anon Public Key)
# Safe to expose to the client.
SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key-here"

# --- AUTH (Internal JWT) ---
JWT_SECRET="generate-a-32-plus-character-internal-secret"

# --- EMAIL (Mailjet) ---
MAILJET_API_KEY=""
MAILJET_API_SECRET=""

# Notifications
SLACK_WEBHOOK_URL=""
