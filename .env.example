# Supabase Configuration (Required)
# Find these in your Supabase Project Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Internal Authentication (Required)
JWT_SECRET=super-secret-jwt-key-minimum-32-chars-long

# App URL & Sender Defaults
APP_URL=https://connect.transferlegacy.com
SENDER_EMAIL=outreach@transferlegacy.com
SENDER_NAME=Transfer Legacy
CRON_SECRET=

# Initial Admin Account Setup
ADMIN_EMAIL=admin@transferlegacy.com
ADMIN_PASSWORD=change-me-immediately

# -----------------------------------------------------------------------------
# Optional ENV Provider Fallbacks (Primary configuration is done in the UI):
# -----------------------------------------------------------------------------
BREVO_API_KEY=
RESEND_API_KEY=
SENDGRID_API_KEY=
POSTMARK_SERVER_TOKEN=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILJET_API_KEY=
MAILJET_API_SECRET=

# Custom SMTP / Amazon SES / Stalwart Fallback
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
