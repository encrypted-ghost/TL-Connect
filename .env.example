# Supabase Configuration
# The following variables are required for the application to function.
# You can find these in your Supabase Project Settings > API.

# Public credentials for the frontend
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Private credentials for the backend (service_role key)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Internal Authentication (JWT)
JWT_SECRET=

# Email Sender Details
SENDER_EMAIL=outreach@transferlegacy.com
SENDER_NAME=Transfer Legacy

# App URL (used in unsubscribe links)
APP_URL=http://localhost:3000

# Server Settings
CRON_SECRET=

# Mailjet API Credentials (optional, mock fallback is used if missing)
MAILJET_API_KEY=
MAILJET_API_SECRET=

# Initial Admin Account setup
ADMIN_EMAIL=admin@transferlegacy.com
ADMIN_PASSWORD=change-me-immediately
