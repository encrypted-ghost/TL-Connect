{
  "entities": {
    "User": {
      "title": "User",
      "description": "System users with RBAC roles",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["ADMIN", "MANAGER", "AGENT", "VIEWER"] },
        "workspaceId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role", "workspaceId"]
    },
    "Workspace": {
      "title": "Workspace",
      "description": "Isolated work environments",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "slug": { "type": "string" }
      }
    },
    "Lead": {
      "title": "Lead",
      "description": "Target outreach contact",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "status": { "type": "string" },
        "workspaceId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "workspaceId"]
    },
    "Campaign": {
      "title": "Campaign",
      "description": "Email outreach sequence",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "status": { "type": "string" },
        "templateId": { "type": "string" },
        "workspaceId": { "type": "string" },
        "scheduledAt": { "type": "string", "format": "date-time" }
      }
    },
    "Template": {
      "title": "Template",
      "description": "Email content template",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "subject": { "type": "string" },
        "bodyHtml": { "type": "string" },
        "workspaceId": { "type": "string" }
      }
    },
    "Domain": {
      "title": "Domain",
      "description": "Sending domains",
      "type": "object",
      "properties": {
        "domain": { "type": "string" },
        "isVerified": { "type": "boolean" },
        "workspaceId": { "type": "string" }
      }
    }
  },
  "firestore": {
    "workspaces/{workspaceId}": {
      "schema": "Workspace",
      "description": "Workspace settings"
    },
    "users/{userId}": {
      "schema": "User",
      "description": "User profile and role"
    },
    "leads/{leadId}": {
      "schema": "Lead",
      "description": "Individual leads"
    },
    "campaigns/{campaignId}": {
      "schema": "Campaign",
      "description": "Outreach campaigns"
    },
    "templates/{templateId}": {
      "schema": "Template",
      "description": "Messaging templates"
    },
    "domains/{domainId}": {
      "schema": "Domain",
      "description": "Verified domains"
    }
  }
}
